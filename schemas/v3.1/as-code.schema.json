{
	"$schema": "https://json-schema.org/draft/2019-09/schema",
	"$id": "https://raw.githubusercontent.com/Neotys-Labs/neoload-models/refs/heads/v3/schemas/v3.1/as-code.schema.json",
	"title": "JSON Schema for NeoLoad as-code files",
	"fileMatch": [
		"*.nl.yaml",
		"*.neoload.yaml",
		"neoload*.yaml",
		"*.nl.yml",
		"*.neoload.yml",
		"neoload*.yml",
		"*.nl.json",
		"*.neoload.json",
		"neoload*.json"
	],
	"type": "object",
	"additionalProperties": false,
	"minProperties": 1,
	"required": ["name"],
	"properties": {
		"$schema": { "$ref": "#/definitions/common/full_url" },
		"schemaVersion": {
			"type": "string",
			"const": "3.1",
			"description": "Schema contract version this file is written for. Must be '3.1' for this schema."
		},
		"name": { "$ref": "#/definitions/common/name" },
		"includes": {
			"title": "Includes",
			"type": "array",
			"minItems": 1,
			"additionalProperties": false,
			"items": { "$ref": "#/definitions/common/text" }
		},
		"variables": {
			"title": "Variables",
			"type": "array",
			"additionalItems": false,
			"minItems": 1,
			"additionalProperties": false,
			"items": {
				"anyOf": [
					{ "$ref": "#/definitions/variables/constant" },
					{ "$ref": "#/definitions/variables/file" },
					{ "$ref": "#/definitions/variables/counter" },
					{ "$ref": "#/definitions/variables/random_number" },
					{ "$ref": "#/definitions/variables/javascript" },
					{ "$ref": "#/definitions/variables/current_date" }
				]
			}
		},
		"servers": {
			"title": "Servers",
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/definitions/server" }
		},
		"sla_profiles": {
			"title": "SLA Profiles",
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/definitions/sla" }
		},
		"populations": {
			"title": "Populations",
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/definitions/populations/population" }
		},
		"scenarios": {
			"title": "Scenarios",
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/definitions/scenario" }
		},
		"user_paths": {
			"title": "User_paths",
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/definitions/user_paths/user_path" }
		},
		"project_settings": {
			"title": "Neoload_Project_settings",
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"dynatrace.enabled": { "type": "boolean" },
				"dynatrace.url": { "$ref": "#/definitions/common/text" },
				"dynatrace.token": { "$ref": "#/definitions/common/text" },
				"qtest.enabled": { "type": "boolean" },
				"qtest.url": { "$ref": "#/definitions/common/text" },
				"qtest.token": { "$ref": "#/definitions/common/text" },
				"qtest.username": { "$ref": "#/definitions/common/text" },
				"qtest.password": { "$ref": "#/definitions/common/text" },
				"qtest.auth_method": { "type": "string", "enum": ["TOKEN", "LOGIN_PWD"] },
				"qtest.project_id": { "type": "integer" },
				"qtest.create_defects": { "type": "boolean" },
				"qtest.cycle_id": { "type": "integer" }
			}
		}
	},
	"definitions": {
		"common": {
			"text": {
				"title": "Value",
				"type": "string",
				"pattern": "^.*$"
			},
			"textblob": {
				"title": "Blob",
				"type": "string",
				"pattern": "((.|\n)*)"
			},
			"positive_number": {
				"title": "Positive Number",
				"type": "integer",
				"minimum": 0
			},
			"duration": {
				"title": "Duration",
				"anyOf": [{ "$ref": "#/definitions/common/time" }, { "$ref": "#/definitions/common/iterations" }]
			},
			"stop_after_options": {
				"title": "variation_policy.stop_after values",
				"anyOf": [{ "$ref": "#/definitions/common/time" }, { "type": "string", "enum": ["current_iteration"] }]
			},
			"start_after_options": {
				"title": "Start after",
				"anyOf": [{ "$ref": "#/definitions/common/time" }, { "$ref": "#/definitions/common/text" }]
			},
			"time": {
				"title": "Time",
				"type": "string",
				"pattern": "^((\\d{1,2}[hms]{1}){1,3})+$"
			},
			"iterations": {
				"title": "Iterations",
				"type": "string",
				"pattern": "^(\\d+ iterations)$"
			},
			"conditions": {
				"title": "Conditions list",
				"type": "array",
				"items": {
					"type": "string",
					"title": "Condition. Format is: operand1 operation operand2  Example: '${MyVariable}' == 'value'",
					"pattern": "^.+(>=|==|!=|<=|>|<|equals|not_equals|contains|not_contains|starts_with|not_starts_with|ends_with|not_ends_with|match_regexp|not_match_regexp|greater|greater_equal|less|less_equal|exists|not_exists).*$"
				}
			},
			"name": {
				"title": "Name",
				"type": "string",
				"pattern": "^.*$"
			},
			"full_url": {
				"title": "Url",
				"type": "string",
				"pattern": "https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}\\b([-a-zA-Z0-9()@:%_\\+.~#?&//=]*)"
			},
			"var_change_policy": {
				"type": "string",
				"default": "each_iteration",
				"enum": ["each_use", "each_request", "each_page", "each_iteration", "each_user"]
			},
			"var_scope": {
				"type": "string",
				"default": "global",
				"enum": ["local", "global", "unique"]
			},
			"var_order": {
				"type": "string",
				"default": "global",
				"enum": ["sequential", "random", "any"]
			},
			"var_out_of_value": {
				"type": "string",
				"default": "global",
				"enum": ["cycle", "stop_test", "no_value_code"]
			}
		},
		"variables": {
			"generic": {
				"type": "object",
				"required": ["name"],
				"properties": {
					"name": { "$ref": "#/definitions/common/name" },
					"description": { "$ref": "#/definitions/common/text" },
					"change_policy": { "$ref": "#/definitions/common/var_change_policy" }
				}
			},
			"constant": {
				"title": "Constant",
				"type": "object",
				"required": ["value"],
				"allOf": [
					{ "$ref": "#/definitions/variables/generic" },
					{
						"properties": {
							"value": { "$ref": "#/definitions/common/text" }
						}
					}
				],
				"unevaluatedProperties": false
			},
			"file": {
				"title": "File",
				"type": "object",
				"required": ["path"],
				"allOf": [
					{ "$ref": "#/definitions/variables/generic" },
					{
						"properties": {
							"column_names": {
								"type": "array",
								"items": [{ "type": "string" }]
							},
							"is_first_line_column_names": {
								"type": "boolean",
								"default": false
							},
							"start_from_line": {
								"type": "integer",
								"default": 1
							},
							"delimiter": {
								"$ref": "#/definitions/common/text",
								"default": ","
							},
							"path": { "$ref": "#/definitions/common/text" },
							"scope": { "$ref": "#/definitions/common/var_scope" },
							"order": { "$ref": "#/definitions/common/var_order" },
							"out_of_value": { "$ref": "#/definitions/common/var_out_of_value" }
						}
					}
				],
				"unevaluatedProperties": false
			},
			"counter": {
				"title": "Counter",
				"type": "object",
				"required": ["start", "end", "increment"],
				"allOf": [
					{ "$ref": "#/definitions/variables/generic" },
					{
						"properties": {
							"start": {
								"type": "number"
							},
							"end": {
								"type": "number"
							},
							"increment": {
								"type": "number"
							},
							"scope": { "$ref": "#/definitions/common/var_scope" },
							"out_of_value": { "$ref": "#/definitions/common/var_out_of_value" }
						}
					}
				],
				"unevaluatedProperties": false
			},
			"random_number": {
				"title": "Random Number",
				"type": "object",
				"required": ["min", "max"],
				"allOf": [
					{ "$ref": "#/definitions/variables/generic" },
					{
						"properties": {
							"min": {
								"type": "number"
							},
							"max": {
								"type": "number"
							},
							"predictable": {
								"type": "boolean"
							}
						}
					}
				],
				"unevaluatedProperties": false
			},
			"javascript": {
				"title": "Javascript",
				"type": "object",
				"required": ["script"],
				"allOf": [
					{ "$ref": "#/definitions/variables/generic" },
					{
						"properties": {
							"script": { "$ref": "#/definitions/common/text" }
						}
					}
				],
				"unevaluatedProperties": false
			},
			"current_date": {
				"title": "Current Date",
				"type": "object",
				"allOf": [
					{ "$ref": "#/definitions/variables/generic" },
					{
						"properties": {
							"pattern": {
								"$ref": "#/definitions/common/text",
								"default": "dd/MM/yyyy HH:mm:ss"
							},
							"increment_value": {
								"type": "integer",
								"default": 0
							},
							"increment_timeunit": {
								"type": "string",
								"default": "second",
								"enum": ["millisecond", "second", "minute", "hour", "day", "month", "year"]
							}
						}
					}
				],
				"unevaluatedProperties": false
			}
		},
		"server": {
			"title": "Server",
			"type": "object",
			"required": ["name", "host"],
			"additionalProperties": false,
			"properties": {
				"name": { "$ref": "#/definitions/common/text" },
				"host": { "$ref": "#/definitions/common/text" },
				"scheme": {
					"type": "string",
					"enum": ["http", "https"]
				},
				"port": {
					"type": "integer"
				},
				"basic_authentication": { "$ref": "#/definitions/authentication/basic" },
				"ntlm_authentication": { "$ref": "#/definitions/authentication/ntlm" },
				"negotiate_authentication": { "$ref": "#/definitions/authentication/negotiate" }
			}
		},
		"authentication": {
			"auth-generic": {
				"type": "object",
				"required": ["login", "password"],
				"properties": {
					"login": { "$ref": "#/definitions/common/text" },
					"password": { "$ref": "#/definitions/common/text" }
				}
			},
			"auth-generic-domain": {
				"type": "object",
				"allOf": [
					{ "$ref": "#/definitions/authentication/auth-generic" },
					{
						"properties": {
							"domain": { "$ref": "#/definitions/common/text" }
						}
					}
				],
				"unevaluatedProperties": false
			},
			"basic": {
				"title": "Basic Authentication",
				"type": "object",
				"allOf": [
					{ "$ref": "#/definitions/authentication/auth-generic" },
					{
						"properties": {
							"realm": { "$ref": "#/definitions/common/text" }
						}
					}
				],
				"unevaluatedProperties": false
			},
			"ntlm": {
				"title": "NTLM Authentication",
				"type": "object",
				"allOf": [{ "$ref": "#/definitions/authentication/auth-generic-domain" }],
				"unevaluatedProperties": false
			},
			"negotiate": {
				"title": "Negotiate Authentication",
				"type": "object",
				"allOf": [{ "$ref": "#/definitions/authentication/auth-generic-domain" }],
				"unevaluatedProperties": false
			}
		},
		"sla": {
			"title": "SLA Profile",
			"type": "object",
			"required": ["name", "thresholds"],
			"additionalProperties": false,
			"properties": {
				"name": { "$ref": "#/definitions/common/text" },
				"description": { "$ref": "#/definitions/common/text" },
				"thresholds": {
					"title": "Thresholds",
					"type": "array",
					"minItems": 1,
					"additionalProperties": false,
					"items": { "$ref": "#/definitions/sla/threshold" }
				}
			},
			"threshold": {
				"title": "Threshold",
				"type": "string",
				"pattern": "^(.*?)\\s(warn\\s(>=|==|<=|>|<))(?=\\s)(.*?)per\\s(test|interval)$"
			}
		},
		"populations": {
			"population": {
				"title": "Population",
				"type": "object",
				"required": ["name"],
				"additionalProperties": false,
				"properties": {
					"name": { "$ref": "#/definitions/common/text" },
					"description": { "$ref": "#/definitions/common/text" },
					"xcomments": {
						"value": "why do we need the substructure 'name' to denote a string list?"
					},
					"user_paths": {
						"type": "array",
						"minItems": 1,
						"additionalItems": false,
						"items": {
							"type": "object",
							"required": ["name"],
							"additionalProperties": false,
							"properties": {
								"name": { "$ref": "#/definitions/common/text" },
								"distribution": {
									"anyOf": [
										{ "type": "string", "pattern": "^\\d{1,3}(\\.\\d)?%?$" },
										{ "type": "number", "minimum": 0, "maximum": 100 }
									]
								}
							}
						}
					}
				}
			},
			"constant_load": {
				"title": "Constant Load",
				"type": "object",
				"required": ["users"],
				"additionalProperties": false,
				"properties": {
					"duration": { "$ref": "#/definitions/common/duration" },
					"start_after": { "$ref": "#/definitions/common/start_after_options" },
					"stop_after": { "$ref": "#/definitions/common/stop_after_options" },
					"users": {
						"type": "integer",
						"default": 1
					},
					"rampup": { "$ref": "#/definitions/common/time" }
				}
			},
			"rampup_load": {
				"title": "Ramp-up Load",
				"type": "object",
				"required": ["min_users", "increment_users", "increment_every"],
				"properties": {
					"duration": { "$ref": "#/definitions/common/duration" },
					"start_after": { "$ref": "#/definitions/common/start_after_options" },
					"stop_after": { "$ref": "#/definitions/common/stop_after_options" },
					"min_users": { "$ref": "#/definitions/common/positive_number" },
					"max_users": { "$ref": "#/definitions/common/positive_number" },
					"increment_users": {
						"type": "integer",
						"default": 1
					},
					"increment_every": { "$ref": "#/definitions/common/duration" },
					"increment_rampup": { "$ref": "#/definitions/common/time" }
				},
				"additionalProperties": false
			},
			"peaks_load": {
				"title": "Peaks Load",
				"type": "object",
				"required": ["minimum", "maximum", "start"],
				"properties": {
					"minimum": { "$ref": "#/definitions/populations/peaks_phase" },
					"maximum": { "$ref": "#/definitions/populations/peaks_phase" },
					"start": {
						"type": "string",
						"enum": ["minimum", "maximum"]
					},
					"duration": { "$ref": "#/definitions/common/duration" },
					"start_after": { "$ref": "#/definitions/common/start_after_options" },
					"step_rampup": { "$ref": "#/definitions/common/text" },
					"stop_after": { "$ref": "#/definitions/common/stop_after_options" }
				},
				"additionalProperties": false
			},
			"peaks_phase": {
				"title": "Peak Phase",
				"type": "object",
				"required": ["users", "duration"],
				"additionalProperties": false,
				"properties": {
					"users": { "$ref": "#/definitions/common/positive_number" },
					"duration": { "$ref": "#/definitions/common/duration" }
				}
			}
		},
		"scenario": {
			"title": "Scenario",
			"type": "object",
			"required": ["name"],
			"additionalProperties": false,
			"properties": {
				"name": { "$ref": "#/definitions/common/text" },
				"description": { "$ref": "#/definitions/common/text" },
				"sla_profile": { "$ref": "#/definitions/common/text" },
				"store_variables_for_raw_data": {
					"type": "boolean",
					"default": false
				},
				"excluded_urls": {
					"type": "array",
					"items": { "$ref": "#/definitions/common/text" }
				},
				"apm_configuration": { "$ref": "#/definitions/scenario/apm" },
				"monitoring": { "$ref": "#/definitions/scenario/monitoring" },
				"rendezvous_policies": {
					"type": "array",
					"items": { "$ref": "#/definitions/scenario/rendezvous_policy" }
				},
				"populations": {
					"title": "Scenario Populations",
					"type": "array",
					"minItems": 1,
					"additionalItems": false,
					"additionalProperties": false,
					"items": {
						"type": "object",
						"required": ["name"],
						"additionalProperties": false,
						"properties": {
							"name": { "$ref": "#/definitions/common/text" },
							"constant_load": { "$ref": "#/definitions/populations/constant_load" },
							"rampup_load": { "$ref": "#/definitions/populations/rampup_load" },
							"peaks_load": { "$ref": "#/definitions/populations/peaks_load" }
						}
					}
				}
			},
			"apm": {
				"title": "APM Configuration",
				"type": "object",
				"properties": {
					"dynatrace_tags": {
						"type": "array",
						"items": { "$ref": "#/definitions/common/text" }
					},
					"dynatrace_anomaly_rules": {
						"type": "array",
						"items": { "$ref": "#/definitions/scenario/dynatrace_anomaly_rule" }
					}
				},
				"additionalProperties": false
			},
			"dynatrace_anomaly_rule": {
				"title": "Dynatrace Anomaly Rule",
				"type": "object",
				"required": ["metric_id", "operator", "value", "severity"],
				"properties": {
					"metric_id": { "$ref": "#/definitions/common/text" },
					"operator": {
						"type": "string",
						"enum": ["ABOVE", "BELOW"]
					},
					"value": { "$ref": "#/definitions/common/text" },
					"severity": {
						"type": "string",
						"enum": ["AVAILABILITY", "CUSTOM_ALERT", "ERROR", "INFO", "PERFORMANCE", "RESOURCE_CONTENTION"]
					}
				},
				"additionalProperties": false
			},
			"monitoring": {
				"title": "Monitoring Parameters",
				"type": "object",
				"properties": {
					"before": { "$ref": "#/definitions/common/time" },
					"after": { "$ref": "#/definitions/common/time" }
				},
				"additionalProperties": false
			},
			"rendezvous_policy": {
				"title": "Rendezvous Policy",
				"type": "object",
				"required": ["name"],
				"properties": {
					"name": { "$ref": "#/definitions/common/text" },
					"when": { "$ref": "#/definitions/common/text" },
					"timeout": { "$ref": "#/definitions/common/time" }
				},
				"additionalProperties": false
			}
		},
		"user_paths": {
			"user_path": {
				"title": "User Path",
				"type": "object",
				"required": ["name", "actions"],
				"additionalProperties": false,
				"properties": {
					"name": { "$ref": "#/definitions/common/text" },
					"description": { "$ref": "#/definitions/common/text" },
					"user_session": {
						"type": "string",
						"enum": ["reset_on", "reset_off", "reset_auto"]
					},
					"init": { "$ref": "#/definitions/user_paths/container" },
					"actions": { "$ref": "#/definitions/user_paths/container" },
					"end": { "$ref": "#/definitions/user_paths/container" }
				}
			},
			"container": {
				"title": "Containers",
				"type": "object",
				"required": ["steps"],
				"additionalProperties": false,
				"properties": {
					"description": { "$ref": "#/definitions/common/text" },
					"sla_profile": {
						"type": "string"
					},
					"steps": { "$ref": "#/definitions/user_paths/steps" }
				}
			},
			"steps": {
				"title": "Steps",
				"type": "array",
				"minItems": 1,
				"items": {
					"type": "object",
					"minProperties": 1,
					"maxProperties": 1,
					"properties": {
						"transaction": { "$ref": "#/definitions/user_paths/actions/transaction" },
						"request": { "$ref": "#/definitions/user_paths/actions/request" },
						"delay": { "$ref": "#/definitions/user_paths/actions/delay" },
						"think_time": { "$ref": "#/definitions/user_paths/actions/think_time" },
						"javascript": { "$ref": "#/definitions/user_paths/actions/javascript" },
						"if": { "$ref": "#/definitions/user_paths/actions/if" },
						"while": { "$ref": "#/definitions/user_paths/actions/while" },
						"loop": { "$ref": "#/definitions/user_paths/actions/loop" },
						"switch": { "$ref": "#/definitions/user_paths/actions/switch" },
						"custom_action": { "$ref": "#/definitions/user_paths/actions/custom_action" }
					},
					"additionalProperties": false
				}
			},
			"actions": {
				"transaction": {
					"name": "transaction",
					"title": "Action: Transaction",
					"type": "object",
					"required": ["name", "steps"],
					"properties": {
						"name": { "$ref": "#/definitions/common/text" },
						"description": { "$ref": "#/definitions/common/text" },
						"sla_profile": { "$ref": "#/definitions/common/text" },
						"steps": { "$ref": "#/definitions/user_paths/steps" }
					},
					"additionalProperties": false
				},
				"request": {
