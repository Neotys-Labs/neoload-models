{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"definitions": {
		"scenario-as-code": {
			"title": "Scenario as code",
			"description": "[Scenario documentation](https://github.com/Neotys-Labs/neoload-models/blob/v3/neoload-project/doc/v3/scenario.md).",
			"type": "object", "additionalProperties": false,
			"required": ["name", "populations"],
			"properties": {
				"name": {"$ref": "#/definitions/required_text"},
				"description": {"type": "string"},
				"sla_profile": {"type": "string"},
				"store_variables_for_raw_data": {"type": "boolean"},
				"monitoring": {
					"type": "object", "additionalProperties": false,
					"properties": {
						"before": {"$ref": "#/definitions/time"},
						"after": {"$ref": "#/definitions/time"}
					}
				},
				"populations": {
					"type": "array", "additionalItems": false,
					"minItems": 1,
					"items": {
						"oneOf": [
							{
								"type": "object", "additionalProperties": false,
								"required": ["name", "constant_load"],
								"properties": {
									"name": {"$ref": "#/definitions/required_text"},
									"constant_load": {"$ref": "#/definitions/constant_load"}
								}
							},
							{
								"type": "object", "additionalProperties": false,
								"required": ["name", "rampup_load"],
								"properties": {
									"name": {"$ref": "#/definitions/required_text"},
									"rampup_load": {"$ref": "#/definitions/rampup_load"}
								}
							},
							{
								"type": "object", "additionalProperties": false,
								"required": ["name", "peaks_load"],
								"properties": {
									"name": {"$ref": "#/definitions/required_text"},
									"peaks_load": {"$ref": "#/definitions/peaks_load"}
								}
							},
							{
								"type": "object", "additionalProperties": false,
								"required": ["name", "custom_load"],
								"properties": {
									"name": {"$ref": "#/definitions/required_text"},
									"custom_load": {"$ref": "#/definitions/custom_load"}
								}
							}
						]
					}
				},
				"rendezvous_policies": {
					"type": "array", "additionalItems": false,
					"items": {
						"type": "object", "additionalProperties": false,
						"required": ["name", "when"],
						"properties": {
							"name": {"$ref": "#/definitions/required_text"},
							"when": {
								"anyOf": [
									{"type": "string", "enum": ["manual"]},
									{"type": "string", "pattern": "^((100)|(\\d{1,2}(\\.\\d*)?))%$"},
									{"type": "integer", "minimum": 0}
								]
							},
							"timeout": {"$ref": "#/definitions/time"}
						}
					}
				},
				"excluded_urls": {
					"type": "array", "additionalItems": false,
					"items": {"type": "string"}
				},
				"apm_configuration": {
					"type": "object", "additionalProperties": false,
					"properties": {
						"dynatrace_tags": {
							"type": "array", "additionalItems": false,
							"items": {"type": "string"}
						},
						"dynatrace_anomaly_rules": {
							"type": "array", "additionalItems": false,
							"items": {
								"type": "object", "additionalProperties": false,
								"required": ["metric_id", "operator", "value", "severity"],
								"properties": {
									"metric_id": {"$ref": "#/definitions/required_text"},
									"operator": {"type": "string", "enum": ["BELOW", "ABOVE"]},
									"value": {"$ref": "#/definitions/required_text"},
									"severity": {"type": "string", "enum": ["AVAILABILITY", "CUSTOM_ALERT", "ERROR", "INFO", "PERFORMANCE", "RESOURCE_CONTENTION"]}
								}
							}
						}
					}
				}
			},
			"example": {
				"name": "LOGIN PERF HEAVY LOAD",
				"description": "User Load for the login page",
				"populations": [
					{
						"name": "Constant user load",
						"constant_load": {
							"users": 100000,
							"duration": "1h5m2s",
							"rampup": "5m2s",
							"start_after": "1m",
							"stop_after": "current_iteration"
						}
					},
					{
						"name": "Start of the work day user load",
						"rampup_load": {
							"increment_every": "1 iterations",
							"increment_users": 10000,
							"min_users": 1000,
							"duration": "1h",
							"increment_rampup": "1m",
							"max_users": 1000000,
							"start_after": "5m2s"
						}
					},
					{
						"name": "Expected Peak user load",
						"peaks_load": {
							"maximum": {
								"duration": "10m",
								"users": 100000
							},
							"minimum": {
								"duration": "2m",
								"users": 100
							},
							"start": "minimum",
							"duration": "12m",
							"start_after": "Random user load"
						}
					},
					{
						"name": "Random user load",
						"custom_load": {
							"steps": [
								{
									"when": "1m",
									"users": 20
								},
								{
									"when": "1h",
									"users": 10
								}
							]
						}
					}
				]
			}
		},
		"required_text": {
			"minLength": 1,
			"pattern": "\\S+$",
			"type": "string"
		},
		"positive_number": {
			"type": "integer",
			"minimum": 0
		},
		"duration": {
			"anyOf": [
				{"$ref": "#/definitions/time"},
				{"$ref": "#/definitions/iterations"}
			]
		},
		"stop_after_options": {
			"anyOf": [
				{"$ref": "#/definitions/time"},
				{"type": "string", "enum": ["current_iteration"]}
			]
		},
		"start_after_options": {
			"anyOf": [
				{"$ref": "#/definitions/time"},
				{"type": "string"}
			]
		},
		"time": {
			"type": "string",
			"pattern": "^(\\d+h)?(\\d+m)?(\\d+s)?$"
		},
		"iterations": {
			"type": "string",
			"pattern": "^\\d+ iterations$"
		},
		"peaks_phase": {
			"type": "object", "additionalProperties": false,
			"required": ["users", "duration"],
			"properties": {
				"users": {"$ref": "#/definitions/positive_number"},
				"duration": {"$ref": "#/definitions/duration"}
			}
		},
		"constant_load": {
			"type": "object", "additionalProperties": false,
			"required": ["users", "duration"],
			"properties": {
				"duration": {"$ref": "#/definitions/duration"},
				"start_after": {"$ref": "#/definitions/start_after_options"},
				"stop_after": {"$ref": "#/definitions/stop_after_options"},
				"users": {
					"type": "integer",
					"default": 1,
					"minimum": 1
				},
				"rampup": {"$ref": "#/definitions/time"}
			}
		},
		"rampup_load": {
			"type": "object", "additionalProperties": false,
			"required": ["min_users", "increment_users", "increment_every", "duration"],
			"properties": {
				"duration": {"$ref": "#/definitions/duration"},
				"start_after": {"$ref": "#/definitions/start_after_options"},
				"stop_after": {"$ref": "#/definitions/stop_after_options"},
				"min_users": {"$ref": "#/definitions/positive_number"},
				"max_users": {"$ref": "#/definitions/positive_number"},
				"increment_users": {
					"type": "integer",
					"default": 1,
					"minimum": 0
				},
				"increment_every": {"$ref": "#/definitions/duration"},
				"increment_rampup": {"$ref": "#/definitions/time"}
			}
		},
		"peaks_load": {
			"type": "object", "additionalProperties": false,
			"required": ["minimum", "maximum", "start", "duration"],
			"properties": {
				"minimum": {"$ref": "#/definitions/peaks_phase"},
				"maximum": {"$ref": "#/definitions/peaks_phase"},
				"start": {
					"type": "string",
					"enum": ["minimum", "maximum"]
				},
				"duration": {"$ref": "#/definitions/duration"},
				"start_after": {"$ref": "#/definitions/start_after_options"},
				"step_rampup": {"$ref": "#/definitions/time"},
				"stop_after": {"$ref": "#/definitions/stop_after_options"}
			}
		},
		"custom_load": {
			"type": "object", "additionalProperties": false,
			"required": ["steps"],
			"properties": {
				"start_after": {"$ref": "#/definitions/start_after_options"},
				"stop_after": {"$ref": "#/definitions/stop_after_options"},
				"rampup": {"$ref": "#/definitions/time"},
				"steps": {
					"type": "array", "additionalItems": false,
					"minItems": 1,
					"items": {
						"type": "object", "additionalProperties": false,
						"required": ["when", "users"],
						"properties": {
							"when": {"$ref": "#/definitions/duration"},
							"users": {"type": "integer", "minimum": 0}
						}
					}
				}
			}
		}
	}
}